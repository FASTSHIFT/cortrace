#!/usr/bin/env bash
# commit-msg hook: enforce Conventional-Commit style subject lines.
#
# Accepted forms (first line of the message):
#   feat(scope): ...   fix(a/b): ...   refactor(x)!: ...   etc.
#   docs: ...          docs(scope): ...   (docs is the ONLY type whose scope is optional)
#   Revert "..."
# where type is one of feat|fix|docs|refactor|test|chore|style|perf,
# the scope uses [a-z0-9_./-], an optional ! marks a breaking change, and a
# non-empty description follows ": ".
#
# Install with: scripts/install-hooks.sh  (sets core.hooksPath to .githooks)
set -euo pipefail
MSG_FILE="$1"
# First non-comment, non-empty line is the subject.
SUBJECT="$(grep -vE '^\s*#' "$MSG_FILE" | grep -vE '^\s*$' | head -n1 || true)"
SCOPE='[a-z0-9_./-]+'
PATTERN="^(Revert \".*\"|docs(\\(${SCOPE}\\))?!?: .+|(feat|fix|refactor|test|chore|style|perf)\\(${SCOPE}\\)!?: .+)\$"
if [[ ! "$SUBJECT" =~ $PATTERN ]]; then
    echo "commit blocked: subject does not match the required format." >&2
    echo "" >&2
    echo "  got:      $SUBJECT" >&2
    echo "  expected: <type>(<scope>): <description>" >&2
    echo "            type = feat|fix|docs|refactor|test|chore|style|perf" >&2
    echo "            scope required (chars [a-z0-9_./-]) for every type except docs;" >&2
    echo "            '!' allowed for breaking changes" >&2
    echo "" >&2
    echo "  examples: fix(decode): cap lister address space" >&2
    echo "            docs: localise notes" >&2
    echo "            feat(api)!: change element schema" >&2
    echo "            Revert \"fix(decode): ...\"" >&2
    exit 1
fi
